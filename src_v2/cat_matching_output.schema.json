{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["matches", "review_items"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {"$ref": "#/$defs/match"}
    },
    "review_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/review_item"}
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paperwork_cat_id",
        "paperwork_display_name",
        "airtable_cat_id",
        "airtable_display_name",
        "match_reason"
      ],
      "properties": {
        "paperwork_cat_id": {"type": "string"},
        "paperwork_display_name": {"type": "string"},
        "airtable_cat_id": {"type": "string"},
        "airtable_display_name": {"type": "string"},
        "match_reason": {"type": "string"}
      }
    },
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_kind",
        "paperwork_cat_id",
        "paperwork_display_name",
        "airtable_cat_id",
        "airtable_display_name",
        "match_reason",
        "resolution"
      ],
      "properties": {
        "review_kind": {
          "type": "string",
          "enum": ["unresolved_paperwork", "unassigned_airtable", "bounded_cohort"]
        },
        "paperwork_cat_id": {"type": ["string", "null"]},
        "paperwork_display_name": {"type": ["string", "null"]},
        "airtable_cat_id": {"type": ["string", "null"]},
        "airtable_display_name": {"type": ["string", "null"]},
        "match_reason": {"type": "string"},
        "resolution": {"type": "string", "const": ""}
      }
    }
  }
}
